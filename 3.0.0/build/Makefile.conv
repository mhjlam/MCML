# CONV 3.0.0 - Data conversion utility for MCML
# Unified Makefile for building CONV only

# Project info
PROJECT = conv
VERSION = 3.0.0
SRCDIR = ../src/conv
BINDIR = ../bin
BUILDDIR = output

# Platform detection and cross-platform commands
ifeq ($(OS),Windows_NT)
	SHELL = cmd.exe
	EXEEXT = .exe
	MKDIR_P = if not exist "$(BINDIR)" mkdir "$(BINDIR)"
	RM = del /Q
	DEVNULL = NUL
	
	# For Windows, use g++ by default (C++20 support)
	CXX = g++
	ifeq ($(CXX),cl)
		CXXFLAGS = /EHsc /std:c++20 /W4 /O2
		LIBS = 
		COMPILER_FOUND = cl
	else ifeq ($(CXX),clang++)
		# Clang++ on Windows
		CXXFLAGS = -std=c++20 -g -Wall -Wextra -O2
		LIBS = 
		COMPILER_FOUND = $(CXX)
	else
		# For g++ and other GCC-compatible compilers
		CXXFLAGS = -std=c++20 -g -Wall -Wextra -O2
		LIBS = 
		COMPILER_FOUND = $(CXX)
	endif
else
	# Unix-like environment (Linux, macOS, WSL when not Windows_NT)
	EXEEXT =
	MKDIR_P = mkdir -p $(BINDIR)
	RM = rm -f
	DEVNULL = /dev/null
	# Unix-like systems - use g++ by default
	CXX = g++
	CXXFLAGS = -std=c++20 -g -Wall -Wextra -O2
	LIBS = 
	COMPILER_FOUND = $(CXX)
endif

TARGET = $(BINDIR)/$(PROJECT)$(EXEEXT)

# Source files for CONV 3.0.0 (C++)
SRCS = $(SRCDIR)/main.cpp \
       $(SRCDIR)/beam_profile.cpp \
       $(SRCDIR)/conv.cpp \
       $(SRCDIR)/convolution_engine.cpp \
       $(SRCDIR)/mcml_reader.cpp \
       $(SRCDIR)/math_utils.cpp \
       $(SRCDIR)/processor.cpp

OBJS = $(BUILDDIR)/main.o \
       $(BUILDDIR)/beam_profile.o \
       $(BUILDDIR)/conv.o \
       $(BUILDDIR)/convolution_engine.o \
       $(BUILDDIR)/mcml_reader.o \
       $(BUILDDIR)/math_utils.o \
       $(BUILDDIR)/processor.o

HEADERS = $(SRCDIR)/conv.hpp \
          $(SRCDIR)/beam_profile.hpp \
          $(SRCDIR)/binary_tree.hpp \
          $(SRCDIR)/convolution_engine.hpp \
          $(SRCDIR)/mcml_reader.hpp \
          $(SRCDIR)/math_utils.hpp \
          $(SRCDIR)/matrix.hpp \
          $(SRCDIR)/processor.hpp

# Create necessary directories
$(BUILDDIR):
ifeq ($(OS),Windows_NT)
	if not exist "$(BUILDDIR)" mkdir "$(BUILDDIR)"
else
	mkdir -p $(BUILDDIR)
endif

$(BINDIR):
ifeq ($(OS),Windows_NT)
	if not exist "$(BINDIR)" mkdir "$(BINDIR)"
else
	mkdir -p $(BINDIR)
endif

# Default target
all: $(BINDIR) $(BUILDDIR) $(TARGET) copy-samples
	@echo Built CONV 3.0.0 with $(COMPILER_FOUND) compiler

# Build CONV executable in bin directory
conv: $(TARGET) copy-samples

$(TARGET): $(BUILDDIR) $(BINDIR) $(OBJS)
ifeq ($(CXX),cl)
	$(CXX) $(CXXFLAGS) $(OBJS) /Fe$@ $(LIBS)
else
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(LIBS)
endif

# Object file rules (object files go in output directory)
$(BUILDDIR)/main.o: $(SRCDIR)/main.cpp $(HEADERS)
ifeq ($(CXX),cl)
	$(CXX) $(CXXFLAGS) /c $(SRCDIR)/main.cpp /Fo$@
else
	$(CXX) $(CXXFLAGS) -I$(SRCDIR) -c $(SRCDIR)/main.cpp -o $@
endif

$(BUILDDIR)/beam_profile.o: $(SRCDIR)/beam_profile.cpp $(HEADERS)
ifeq ($(CXX),cl)
	$(CXX) $(CXXFLAGS) /c $(SRCDIR)/beam_profile.cpp /Fo$@
else
	$(CXX) $(CXXFLAGS) -I$(SRCDIR) -c $(SRCDIR)/beam_profile.cpp -o $@
endif

$(BUILDDIR)/conv.o: $(SRCDIR)/conv.cpp $(HEADERS)
ifeq ($(CXX),cl)
	$(CXX) $(CXXFLAGS) /c $(SRCDIR)/conv.cpp /Fo$@
else
	$(CXX) $(CXXFLAGS) -I$(SRCDIR) -c $(SRCDIR)/conv.cpp -o $@
endif

$(BUILDDIR)/convolution_engine.o: $(SRCDIR)/convolution_engine.cpp $(HEADERS)
ifeq ($(CXX),cl)
	$(CXX) $(CXXFLAGS) /c $(SRCDIR)/convolution_engine.cpp /Fo$@
else
	$(CXX) $(CXXFLAGS) -I$(SRCDIR) -c $(SRCDIR)/convolution_engine.cpp -o $@
endif

$(BUILDDIR)/mcml_reader.o: $(SRCDIR)/mcml_reader.cpp $(HEADERS)
ifeq ($(CXX),cl)
	$(CXX) $(CXXFLAGS) /c $(SRCDIR)/mcml_reader.cpp /Fo$@
else
	$(CXX) $(CXXFLAGS) -I$(SRCDIR) -c $(SRCDIR)/mcml_reader.cpp -o $@
endif

$(BUILDDIR)/math_utils.o: $(SRCDIR)/math_utils.cpp $(HEADERS)
ifeq ($(CXX),cl)
	$(CXX) $(CXXFLAGS) /c $(SRCDIR)/math_utils.cpp /Fo$@
else
	$(CXX) $(CXXFLAGS) -I$(SRCDIR) -c $(SRCDIR)/math_utils.cpp -o $@
endif

$(BUILDDIR)/processor.o: $(SRCDIR)/processor.cpp $(HEADERS)
ifeq ($(CXX),cl)
	$(CXX) $(CXXFLAGS) /c $(SRCDIR)/processor.cpp /Fo$@
else
	$(CXX) $(CXXFLAGS) -I$(SRCDIR) -c $(SRCDIR)/processor.cpp -o $@
endif

# Copy sample files to bin directory
copy-samples: $(BINDIR)
ifeq ($(OS),Windows_NT)
	@echo Copying sample files to bin directory...
	@if exist "$(SRCDIR)\..\..\sample" ( \
		if not exist "$(BINDIR)\sample" mkdir "$(BINDIR)\sample" && \
		xcopy /E /Y "$(SRCDIR)\..\..\sample\*" "$(BINDIR)\sample\" >$(DEVNULL) 2>&1 \
	) else ( \
		echo Warning: sample directory not found \
	)
else
	@echo Copying sample files to bin directory...
	@if [ -d "$(SRCDIR)/../../sample" ]; then \
		mkdir -p "$(BINDIR)/sample" && \
		cp -r "$(SRCDIR)/../../sample/"* "$(BINDIR)/sample/" 2>$(DEVNULL) || true; \
	else \
		echo Warning: sample directory not found; \
	fi
endif

# Test with sample input files (if any exist for CONV)
test: $(TARGET)
	@echo Testing CONV 2.1.0...
ifeq ($(OS),Windows_NT)
	@if not exist "test" mkdir "test"
	@echo Running: $(PROJECT)$(EXEEXT) with sample2.mco...
	@if exist "test/sample2.rat" ( \
		cmd /c "cd $(BINDIR) && (echo i && echo sample/sample2.mco && echo r && echo ../build/test/sample2.rat && echo w && echo q && echo y) | $(PROJECT)$(EXEEXT) >nul 2>&1" \
	) else ( \
		cmd /c "cd $(BINDIR) && (echo i && echo sample/sample2.mco && echo r && echo ../build/test/sample2.rat && echo q && echo y) | $(PROJECT)$(EXEEXT) >nul 2>&1" \
	)
else
	@mkdir -p test
	@echo Running: $(PROJECT)$(EXEEXT) with sample2.mco...
	@if [ -f "test/sample2.rat" ]; then \
		cd $(BINDIR) && (echo "i"; echo "sample/sample2.mco"; echo "r"; echo "../build/test/sample2.rat"; echo "w"; echo "q"; echo "y") | ./$(PROJECT)$(EXEEXT) >/dev/null 2>&1; \
	else \
		cd $(BINDIR) && (echo "i"; echo "sample/sample2.mco"; echo "r"; echo "../build/test/sample2.rat"; echo "q"; echo "y") | ./$(PROJECT)$(EXEEXT) >/dev/null 2>&1; \
	fi
endif
	@echo CONV test completed successfully.

clean:
ifeq ($(OS),Windows_NT)
	if exist "$(BUILDDIR)\*.o" $(RM) "$(BUILDDIR)\*.o"
	if exist "$(BUILDDIR)\*.mco" $(RM) "$(BUILDDIR)\*.mco"
else
	$(RM) $(BUILDDIR)/*.o $(BUILDDIR)/*.mco 2>/dev/null || true
endif
ifeq ($(OS),Windows_NT)
	@if exist "test" rmdir /S /Q "test" >$(DEVNULL) 2>&1 || echo.
else
	@rm -rf test 2>$(DEVNULL) || true
endif

realclean: clean
ifeq ($(OS),Windows_NT)
	@if exist "$(TARGET)" del /Q "$(TARGET)" >$(DEVNULL) 2>&1 || echo.
	@if exist "$(BINDIR)\sample" rmdir /S /Q "$(BINDIR)\sample" >$(DEVNULL) 2>&1 || echo.
else
	$(RM) $(TARGET)
	@rm -rf "$(BINDIR)/sample" 2>$(DEVNULL) || true
endif
	$(RM) *.mco

# Help target
help:
	@echo CONV $(VERSION) Build System
	@echo Available targets:
	@echo   all         - Build CONV (default)
	@echo   conv        - Build CONV executable
	@echo   test        - Build and test CONV
	@echo   clean       - Remove object files, test directory, and output
	@echo   realclean   - Remove all generated files
	@echo   help        - Show this help message

# Phony targets
.PHONY: all conv clean realclean test help copy-samples
